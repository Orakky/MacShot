# 构建产物与临时物
build/
DerivedData/
build/Derived/
# SPM 在包目录下生成（swift build / swift test）
.build/
*.app/
*.dmg
*.icns
*.xcarchive
.swiftpm/
Package.resolved.bak

# 交付素材（Tests/Fixtures 里的渲染基线除外，见文件末尾）
# 交付素材（截图基线之外）
*.tmp.png
# 品牌素材：SVG 是真源，对照页渲染图不入库
assets/branding/preview/

# 编辑器与系统
.idea/
.vscode/
*.swp
.DS_Store

# 本地覆盖（含个人路径/凭据，永不入库）
*.local
.envrc

# 例外：渲染基线是要入库的（人工确认过的判据资产）
!Packages/MacShotKit/Tests/Fixtures/**/*.png
